# Copy to .env and adjust. Every value is optional.

# ── where the UI is published ────────────────────────────────────────────────
AI_CHAT_PORT=8300

# ── secrets (change both before using real data) ────────────────────────────
# Encrypts the database URIs users add from the UI
AI_CHAT_SECRET_KEY=change-me-please
AI_CHAT_METADB_PASSWORD=aichat

# ── LLM ──────────────────────────────────────────────────────────────────────
# openrouter (default) — key from https://openrouter.ai/keys. The chat uses JSON
# mode, so pick a model that supports response_format.
AI_CHAT_PROVIDER=openrouter
AI_CHAT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
# Ollama / any other OpenAI-compatible server (vLLM, LM Studio, OpenAI) instead:
# AI_CHAT_PROVIDER=opensource
# AI_CHAT_MODEL=llama3.1:8b
# with the "ollama" profile use http://ollama:11434/v1
# AI_CHAT_BASE_URL=http://host.docker.internal:11434/v1
# AI_CHAT_API_KEY=ollama
# Anthropic instead:
# AI_CHAT_PROVIDER=anthropic
# AI_CHAT_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...
AI_CHAT_LLM_TIMEOUT=60

# ── access ───────────────────────────────────────────────────────────────────
# Require one of these keys (X-API-Key header; the UI asks for it) — comma separated
AI_CHAT_API_KEYS=
# Behind an auth proxy that sets X-User-Id, give every user their own chats/charts
AI_CHAT_TRUST_USER_HEADER=false
# Let users add database connections from the UI
AI_CHAT_ALLOW_UI_CONNECTIONS=true
# Other origins allowed to call the API (embedding), comma separated
AI_CHAT_CORS_ORIGINS=

# ── limits ───────────────────────────────────────────────────────────────────
AI_CHAT_RATE_LIMIT=20
AI_CHAT_QUERY_TIMEOUT=60
AI_CHAT_WORKER_CONCURRENCY=4

# ── extra database drivers baked into the backend image ─────────────────────
# PostgreSQL and MySQL are included. e.g. "pymssql snowflake-sqlalchemy sqlalchemy-bigquery"
EXTRA_PIP_PACKAGES=
